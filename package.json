{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:e2e": "playwright test",
        "test:e2e:auth": "php artisan db:seed --class=AuthTestUserSeeder --force && playwright test tests/Browser/auth.spec.js",
        "test:e2e:group-bas": "playwright test tests/Browser/group-basketball.spec.js",
        "test:e2e:group-bas-admin": "playwright test tests/Browser/admin-group-basketball.spec.js",
        "test:e2e:ptb": "playwright test tests/Browser/private-training.spec.js",
        "test:e2e:ptm": "playwright test tests/Browser/private-training-management.spec.js",
        "test:e2e:ptp": "playwright test tests/Browser/private-training-package.spec.js",
        "test:e2e:rev-rat": "playwright test tests/Browser/review-rating.spec.js",
        "test:e2e:cour-boo": "playwright test tests/Browser/court-booking.spec.js",
        "test:e2e:credit-m": "playwright test tests/Browser/credit-management.spec.js",
        "test:e2e:co-as-m": "playwright test tests/Browser/coach-assistant-management.spec.js",
        "test:e2e:web-m": "playwright test tests/Browser/website-manage.spec.js",
        "test:e2e:credit-pack": "playwright test tests/Browser/credit-packages.spec.js",
        "test:e2e:credit-pur": "playwright test tests/Browser/credit-purchase.spec.js",
        "test:e2e:staff-sch": "playwright test tests/Browser/staff-schedule.spec.js",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.4.27",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "postcss": "^8.5.8",
        "tailwindcss": "^4.2.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "promptpay-qr": "^0.5.0",
        "qrcode": "^1.5.4"
    }
}
